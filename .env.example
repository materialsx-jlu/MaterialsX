MATERIALSX_DEV_MODE=<0_OR_1>
MATERIALSX_RENDERER_URL=<LOCAL_RENDERER_URL>
MATERIALSX_PYTHON=<ABSOLUTE_PYTHON_PATH>
MATERIALSX_QE_IMAGE=<PINNED_QE_IMAGE>
# Build-time public address source. Do not place credentials in this YAML.
MATERIALSX_DEPLOY_MANIFEST=/absolute/private/path/to/deployment.yaml
MATERIALSX_RELEASE_CHANNEL=<preview_OR_stable>
MATERIALSX_SITE_RELEASE_CHANNEL=<preview_OR_stable>
SITE_ORIGIN=https://replace-with-approved-domain.invalid
ROOTFLOWAI_BASE_URL=<SERVER_ONLY_API_BASE_URL>
ROOTFLOWAI_API_KEY=<SERVER_ONLY_SECRET>
ROOTFLOWAI_MODEL=<SERVER_ONLY_MODEL_ID>
ROOTFLOWAI_TEST_BUDGET_FEN=<EXPLICIT_TEST_BUDGET_MAX_3000_FEN>
ROOTFLOWAI_INPUT_PRICE_FEN_PER_MILLION=<CONFIRMED_EFFECTIVE_INPUT_PRICE>
ROOTFLOWAI_OUTPUT_PRICE_FEN_PER_MILLION=<CONFIRMED_EFFECTIVE_OUTPUT_PRICE>
ROOTFLOWAI_ACCOUNT_GROUP=<CONFIRMED_ACCOUNT_GROUP>
ROOTFLOWAI_MEMBERSHIP=<CONFIRMED_MEMBERSHIP>
ROOTFLOWAI_PRICE_REFERENCE=<PRIVATE_PRICING_EVIDENCE_REFERENCE>
ROOTFLOWAI_PRICE_CONFIRMED=<0_OR_1>
MP_API_KEY=<OPTIONAL_MATERIALS_PROJECT_SECRET>
MATERIALSX_ENV=<development_OR_production>
MATERIALSX_DATABASE_URL=<SERVER_ONLY_POSTGRES_DSN>
MATERIALSX_IDENTITY_MASTER_KEY=<SERVER_ONLY_BASE64_32_BYTE_KEY>
MATERIALSX_IDENTITY_ADDR=<IDENTITY_LISTEN_HOST:PORT>
MATERIALSX_IDENTITY_PUBLIC_URL=<PUBLIC_IDENTITY_ORIGIN>
MATERIALSX_IDENTITY_URL=<DESKTOP_IDENTITY_ORIGIN_NO_SECRETS>
MATERIALSX_TRUSTED_PROXY_CIDRS=<EXPLICIT_PROXY_CIDRS_OR_EMPTY>
MATERIALSX_IDENTITY_TEST_DATABASE_URL=<ISOLATED_TEST_DATABASE_DSN>
MATERIALSX_POSTGRES_BIN=<POSTGRESQL_16_BIN_DIRECTORY_FOR_TESTS>
MATERIALSX_CLOUD_MODE=<disabled_OR_alpha_OR_paid-pilot_OR_paid-beta_OR_mx-production>
MATERIALSX_CLOUD_ROUTE_VERIFIED=<0_OR_1_AFTER_EXACT_MODEL_PROBE>
MATERIALSX_CLOUD_MAX_REQUESTS=<INTEGER_0_UNLIMITED_OR_POSITIVE>
MATERIALSX_CLOUD_MAX_OUTPUT_TOKENS=<INTEGER_1_TO_131072>
MATERIALSX_CLOUD_MAX_DURATION_SECONDS=<INTEGER_1_TO_86400>
MATERIALSX_CLOUD_DISABLE_RATE_LIMIT=<0_OR_1>
MATERIALSX_CLOUD_MAX_CONCURRENT=<INTEGER_0_UNLIMITED_TO_64>
# MX production uses a separate, approved release; diagnostic model allowlist stays empty there.
MATERIALSX_MX03_GATEWAY_MODE=<EMPTY_OR_diagnostic_OR_wallet_OR_wallet-production>
MATERIALSX_MX03_DIAGNOSTIC_MODELS=
MATERIALSX_MX03_PROBE_REPORT_PATH=
# MX production requires all four matching production modes and private release evidence.
MATERIALSX_MX03_PAYMENT_MODE=<EMPTY_OR_test_OR_wechat-live_OR_wechat-production>
MATERIALSX_MX03_PRICE_VERSION=<APPROVED_MX_RELEASE_ID_OR_EMPTY>
MATERIALSX_MX_PRODUCTION_APPROVAL_FILE=<SERVER_ONLY_ABSOLUTE_PRIVATE_APPROVAL_JSON_OR_EMPTY>
MATERIALSX_LITELLM_URL=
MATERIALSX_LITELLM_GATEWAY_KEY=
# Server-side model registry export; use an absolute private path shared with LiteLLM.
MATERIALSX_MODEL_MANIFEST_PATH=/absolute/private/path/model-registry.json
# Optional restricted diagnostic key for model probes. Never expose it to the browser.
MATERIALSX_LITELLM_ONBOARDING_KEY=<SERVER_ONLY_RESTRICTED_LITELLM_KEY>
MATERIALSX_METERING_PRICE_VERSION=<IMMUTABLE_SALES_PRICE_VERSION_OR_EMPTY>
MATERIALSX_PROCUREMENT_PRICE_VERSION=<CONFIRMED_IMMUTABLE_PROCUREMENT_VERSION_OR_EMPTY>
MATERIALSX_PAYMENT_MODE=<disabled_OR_test_IN_ISOLATED_DEV_DB_OR_wechat-native_SERVER_ONLY>
WECHAT_PAY_MCH_ID=<SERVER_ONLY_MERCHANT_ID>
WECHAT_PAY_APP_ID=<SERVER_ONLY_BOUND_APP_ID>
WECHAT_PAY_CERT_SERIAL=<SERVER_ONLY_MERCHANT_CERTIFICATE_SERIAL>
WECHAT_PAY_PRIVATE_KEY_PATH=<SERVER_ONLY_ABSOLUTE_PRIVATE_PEM_PATH>
WECHAT_PAY_PUBLIC_KEY_ID=<SERVER_ONLY_WECHAT_PAY_PUB_KEY_ID>
WECHAT_PAY_PUBLIC_KEY_PATH=<SERVER_ONLY_ABSOLUTE_PLATFORM_PUBLIC_PEM_PATH>
WECHAT_PAY_API_V3_KEY=<SERVER_ONLY_32_BYTE_API_V3_SECRET>
MATERIALSX_WECHAT_CONFIG_PATH=<OPTIONAL_SERVER_ONLY_ABSOLUTE_WEIXIN_RUNTIME_YAML_PATH>
MATERIALSX_WECHAT_RUNTIME_DIR=<OPTIONAL_SERVER_ONLY_ABSOLUTE_RUNTIME_ROOT_FOR_RELATIVE_PEM_PATHS>

# M5.5 server-only static bundle and deployment-reviewed release gates
MATERIALSX_ADMIN_ASSET_DIR=/absolute/path/to/dist/apps/admin
MATERIALSX_RELEASE_APPROVALS_FILE=/absolute/private/path/to/release-approvals.json

# M5.3B: explicit designated account only; never a provider key in the desktop.
MATERIALSX_PAID_PILOT_ACCOUNT=<SERVER_ONLY_DESIGNATED_ACCOUNT_ID_OR_EMPTY>

# M5 lifecycle: off until deployment prerequisites and terms are approved.
MATERIALSX_EMAIL_ENABLED=0
MATERIALSX_SIGNUP_ENABLED=0
MATERIALSX_TERMS_VERSION=replace-with-approved-version
MATERIALSX_TERMS_URL=https://replace-with-approved-domain.invalid/terms
MATERIALSX_MAIL_MODE=disabled
MATERIALSX_MAIL_DIRECTORY=/absolute/private/development-mail
MATERIALSX_SMTP_ADDRESS=replace-with-mail-host.invalid:587
MATERIALSX_SMTP_USER=replace-with-smtp-user
MATERIALSX_SMTP_PASSWORD=replace-with-secret-from-private-configuration
MATERIALSX_MAIL_FROM=replace-with-sender@example.invalid
MATERIALSX_ALERT_EMAIL=replace-with-operator@example.invalid
# 1 CNY = 100,000,000 microfen; zero means threshold disabled, not zero cost.
MATERIALSX_COST_ALERT_DAILY_MICROFEN=0
MATERIALSX_BETA_APPROVALS_FILE=/absolute/private/beta-approvals.json
MATERIALSX_INPUT_COUNTER_EXECUTABLE=/absolute/reviewed/route-specific-counter
MATERIALSX_INPUT_COUNTER_SHA256=replace-with-reviewed-executable-sha256
MATERIALSX_PUBLIC_HOST=replace-with-approved-domain.invalid

# Only for loopback development; production rejects this switch. Local launcher sets 1.
MATERIALSX_LOCAL_DISABLE_ADMIN_TOTP=0

# 0.3.5: separately deployed billing Web and private Go console API.
MATERIALSX_BILLING_ADMIN_PUBLIC_URL=http://127.0.0.1:8790
MATERIALSX_BILLING_GO_ORIGIN=http://127.0.0.1:8788
MATERIALSX_BILLING_WEB_ADDRESS=127.0.0.1:8790
MATERIALSX_BILLING_PROXY_TOKEN=replace-with-private-random-32-plus-character-token

# M6.11: predefined public metadata discovery while the app is open (0 disables).
MATERIALSX_DISCOVERY_AUTOSYNC=1

# UA.4: local read-only MOOS MCP. Set an absolute service directory on this machine.
MATERIALSX_MOOS_MCP_DIRECTORY=/absolute/path/to/MOOS/services/materials-mcp
MATERIALSX_MOOS_ORIGIN=http://127.0.0.1:8080

# UA.13: team service, same public origin as M5; private ACL database, no secrets here.
MATERIALSX_TEAM_DATA=runtime/team/team.sqlite
MATERIALSX_TEAM_PUBLIC_ORIGIN=https://api.materialsx.example
MATERIALSX_TEAM_PORT=8793
MATERIALSX_TEAM_DEVELOPMENT=0
MATERIALSX_TEAM_TRUSTED_LOOPBACK_PROXY=0
MATERIALSX_TEAM_TLS_KEY=/absolute/private/privkey.pem
MATERIALSX_TEAM_TLS_CERT=/absolute/private/fullchain.pem

# Optional absolute directory for an isolated local profile; empty keeps the default.
MATERIALSX_PROFILE_PATH=

# OD.6 server-only observability and independent encrypted backups.
MATERIALSX_METRICS_TOKEN=<PRIVATE_32_PLUS_CHARACTER_TOKEN>
MATERIALSX_BACKUP_KEY_FILE=/absolute/private/path/to/backup-key.hex
MATERIALSX_LITELLM_DATABASE_URL=<SERVER_ONLY_POSTGRESQL_DSN>
MATERIALSX_TEAM_SQLITE_PATH=/absolute/private/path/to/team.sqlite
MATERIALSX_MODEL_CREDENTIALS_PATH=/absolute/private/path/to/model-credentials.json
MATERIALSX_MOOS_SOURCE_PATH=/absolute/private/path/to/moos-source
MATERIALSX_OD6_RESTORE_DATABASE_URL=<OPTIONAL_LOCAL_EMPTY_RESTORE_TEST_DATABASE_DSN>
MATERIALSX_OD6_AUDIT_FILE=/absolute/private/path/to/deployment-audit.jsonl
MATERIALSX_OD6_CHANNEL=preview
MATERIALSX_OD6_OPERATOR=<OPERATOR_ID>
MATERIALSX_OD6_REASON=<RELEASE_OR_ROLLBACK_REASON>
MATERIALSX_OD6_EXPECTED_CATALOG_REVISION=<REVIEWED_SHA256_OR_EMPTY>
MATERIALSX_OD6_MOOS_HEALTH_ORIGIN=http://127.0.0.1:8793
MATERIALSX_OD6_MOOS_HOST=<PUBLIC_RESEARCH_HOST_WHEN_PROBING_PRIVATE_LOOPBACK>
MATERIALSX_OD6_IDENTITY_HOST=<PUBLIC_API_HOST_WHEN_PROBING_PRIVATE_LOOPBACK>
