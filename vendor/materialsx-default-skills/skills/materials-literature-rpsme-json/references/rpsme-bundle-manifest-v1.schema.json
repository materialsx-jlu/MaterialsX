{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-material.local/schemas/rpsme-bundle-manifest-v1.schema.json",
  "title": "RPSME Bundle 1.0 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "source_key", "ontology_path", "ontology_sha256", "files", "created_at", "generator", "profile"],
  "properties": {
    "bundle_version": { "const": "rpsme-bundle-1.0" },
    "source_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$" },
    "ontology_path": { "$ref": "#/$defs/relativePath" },
    "ontology_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundleFile" }
    },
    "profile": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*(?:-[A-Za-z0-9._:-]+)*$", "minLength": 3 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\][^\\\\]*$",
      "description": "POSIX relative path. Deterministic validation additionally rejects dot segments, NULs and normalization collisions."
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_level", "redistribution_allowed", "rights_basis"],
      "properties": {
        "access_level": { "enum": ["public", "restricted", "private_research", "unknown"] },
        "redistribution_allowed": { "type": ["boolean", "null"] },
        "rights_basis": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_size", "media_type", "role", "profile"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "role": { "enum": ["ontology", "published_figure", "published_panel", "thumbnail", "native_raw", "structure_input", "input_script", "force_field", "mesh", "trajectory", "log", "output_table", "output_figure", "validation", "other"] },
        "asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "origin_type": { "enum": ["native_raw", "published_original", "pdf_extracted", "derived_thumbnail", "simulation_input", "simulation_output", "external_reference"] },
        "parent_asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "source_document_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "source_locator": { "type": "object" },
        "derivation": { "type": "object" },
        "rights": { "$ref": "#/$defs/rights" },
        "profile": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "enum": ["ontology", "validation"] } }, "required": ["role"] },
          "then": { "properties": { "asset_id": { "type": "null" } } }
        },
        {
          "if": { "not": { "properties": { "role": { "enum": ["ontology", "validation"] } }, "required": ["role"] } },
          "then": { "required": ["asset_id", "origin_type", "rights"] }
        }
      ]
    }
  }
}
