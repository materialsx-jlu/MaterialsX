{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-material.local/schemas/rpsme-patent-package-v2.schema.json",
  "title": "RPSME Ontology Patent Package v2",
  "type": "object",
  "required": [
    "package_version", "schema_version", "experiment_contract", "prompt_version", "generated_at",
    "generator", "source", "experiment_records", "entities", "relations", "assertions", "evidence",
    "quality_assessments"
  ],
  "properties": {
    "package_version": { "const": "rpsme-patent-package-v2" },
    "schema_version": { "enum": ["rpsme-ontology-1.0", "rpsme-ontology-1.1", "rpsme-ontology-1.2", "rpsme-ontology-1.3", "rpsme-ontology-1.4"] },
    "experiment_contract": { "const": "rpsme-experiment-contract-v2" },
    "prompt_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "version", "deterministic"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "model": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "source": { "$ref": "#/$defs/sourceDocument" },
    "document_set": { "$ref": "#/$defs/documentSet" },
    "experiment_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/experimentRecord" } },
    "entities": { "$ref": "#/$defs/entities" },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "quality_assessments": { "type": "array", "items": { "$ref": "#/$defs/qualityAssessment" } },
    "bundle": { "$ref": "#/$defs/bundleDescriptor" },
    "asset_manifest": { "$ref": "#/$defs/assetManifest" },
    "paper_analysis": { "$ref": "#/$defs/paperAnalysis" },
    "research_opportunities": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/researchOpportunity" } },
    "migration": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "rpsme-ontology-1.2" } }, "required": ["schema_version"] },
      "then": {
        "required": ["document_set"],
        "properties": { "entities": { "required": ["simulation_results"] } }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": "rpsme-ontology-1.3" } }, "required": ["schema_version"] },
      "then": {
        "required": ["document_set", "bundle", "asset_manifest"],
        "properties": {
          "entities": {
            "required": ["simulation_results", "instrument_mentions", "simulation_runs", "simulation_parameters", "asset_references"]
          }
        }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": "rpsme-ontology-1.4" } }, "required": ["schema_version"] },
      "then": {
        "required": ["document_set", "bundle", "asset_manifest", "paper_analysis", "research_opportunities"],
        "properties": { "entities": { "required": ["simulation_results", "instrument_mentions", "simulation_runs", "simulation_parameters", "asset_references"] } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*(?:-[A-Za-z0-9._:-]+)*$", "minLength": 3 },
    "valueStatus": { "enum": ["reported", "inherited", "calculated", "digitized", "predicted", "inferred", "pending"] },
    "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "profile": { "type": "object" },
    "localizedText": {
      "type": "object", "required": ["zh-CN", "en"], "additionalProperties": false,
      "properties": { "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "opportunityFact": {
      "type": "object", "required": ["statement", "evidence_ids"],
      "properties": { "statement": { "$ref": "#/$defs/localizedText" }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } }
    },
    "paperAnalysis": {
      "type": "object",
      "required": ["analysis_id", "analysis_version", "source_scope", "paper_type", "core_idea", "core_contribution", "real_breakthrough", "breakthrough_types", "paper_facts", "limitations", "research_context"],
      "properties": {
        "analysis_id": { "$ref": "#/$defs/id" }, "analysis_version": { "type": "integer", "minimum": 1 },
        "source_scope": { "enum": ["abstract", "full_text"] }, "paper_type": { "type": "string", "minLength": 1 },
        "core_idea": { "$ref": "#/$defs/localizedText" }, "core_contribution": { "$ref": "#/$defs/localizedText" }, "real_breakthrough": { "$ref": "#/$defs/localizedText" },
        "breakthrough_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paper_facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/opportunityFact" } },
        "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedText" } },
        "research_context": { "type": "object" }
      }
    },
    "opportunityScore": {
      "type": "object", "required": ["score", "reason"], "additionalProperties": false,
      "properties": { "score": { "type": "integer", "minimum": 1, "maximum": 10 }, "reason": { "$ref": "#/$defs/localizedText" } }
    },
    "opportunityKeyword": {
      "type": "object", "required": ["key", "category", "zh-CN", "en", "source", "status"], "additionalProperties": false,
      "properties": { "key": { "type": "string", "minLength": 1 }, "category": { "type": "string", "minLength": 1 }, "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 }, "source": { "enum": ["controlled_vocabulary", "auto_generated"] }, "status": { "enum": ["active", "pending_review"] } },
      "allOf": [{ "if": { "properties": { "source": { "const": "auto_generated" } } }, "then": { "properties": { "status": { "const": "pending_review" } } } }]
    },
    "researchOpportunity": {
      "type": "object",
      "required": ["direction_id", "ordinal", "archetype", "title", "objective", "rationale", "research_question", "hypothesis", "novelty", "novelty_status", "value_status", "evidence_layers", "minimum_validation", "experiment_design", "simulation_plan", "execution", "budget", "risks", "scores", "publication_target", "recommendation", "keywords", "next_7_days"],
      "properties": {
        "direction_id": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 }, "archetype": { "enum": ["validation", "extension", "platform"] },
        "title": { "$ref": "#/$defs/localizedText" }, "objective": { "$ref": "#/$defs/localizedText" }, "rationale": { "$ref": "#/$defs/localizedText" }, "research_question": { "$ref": "#/$defs/localizedText" }, "hypothesis": { "$ref": "#/$defs/localizedText" }, "novelty": { "$ref": "#/$defs/localizedText" },
        "novelty_status": { "enum": ["preliminary", "literature_screened", "expert_reviewed"] }, "value_status": { "const": "derived" },
        "novelty_screening": { "type": "object", "required": ["query", "searched_at", "competing_papers"], "properties": { "query": { "type": "string", "minLength": 1 }, "searched_at": { "type": "string", "format": "date-time" }, "competing_papers": { "type": "array" } } },
        "expert_review": { "type": "object", "required": ["reviewer", "reviewed_at"], "properties": { "reviewer": { "type": "string", "minLength": 1 }, "reviewed_at": { "type": "string", "format": "date-time" } } },
        "evidence_layers": { "type": "object", "required": ["paper_facts", "reasoned_inference", "unverified_assumptions"] },
        "minimum_validation": { "type": "object", "required": ["design", "measurements", "success_criteria", "stop_conditions"] },
        "experiment_design": { "type": "object", "required": ["samples", "variables", "controls", "process", "characterization", "performance_tests", "statistics", "sample_size", "success_criteria", "failure_criteria", "next_decision"] },
        "simulation_plan": {
          "type": "object", "required": ["status"], "properties": { "status": { "enum": ["applicable", "not_applicable"] } },
          "allOf": [{ "if": { "properties": { "status": { "const": "applicable" } } }, "then": { "required": ["method", "inputs", "parameters", "expected_outputs", "experimental_cross_validation"] }, "else": { "required": ["reason"] } }]
        },
        "execution": { "type": "object", "required": ["required_conditions", "timeline", "owner"] },
        "budget": { "type": "object", "required": ["currency", "min", "max", "assumptions", "includes", "excludes"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } } },
        "risks": { "type": "object", "required": ["items", "stop_conditions"] },
        "scores": { "type": "object", "required": ["feasibility", "scientific_value", "novelty", "difficulty", "cost", "competition", "publication_potential"], "additionalProperties": false, "properties": { "feasibility": { "$ref": "#/$defs/opportunityScore" }, "scientific_value": { "$ref": "#/$defs/opportunityScore" }, "novelty": { "$ref": "#/$defs/opportunityScore" }, "difficulty": { "$ref": "#/$defs/opportunityScore" }, "cost": { "$ref": "#/$defs/opportunityScore" }, "competition": { "$ref": "#/$defs/opportunityScore" }, "publication_potential": { "$ref": "#/$defs/opportunityScore" } } },
        "publication_target": { "type": "object", "required": ["level", "rationale", "evidence_gaps"] }, "recommendation": { "enum": ["do", "observe", "drop"] },
        "keywords": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/opportunityKeyword" } },
        "next_7_days": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/localizedText" } }
      },
      "allOf": [
        { "if": { "properties": { "novelty_status": { "const": "literature_screened" } } }, "then": { "required": ["novelty_screening"] } },
        { "if": { "properties": { "novelty_status": { "const": "expert_reviewed" } } }, "then": { "required": ["expert_review"] } }
      ]
    },
    "sourceFile": {
      "type": "object",
      "required": ["document_id", "role", "filename", "sha256", "page_count"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["main", "supplementary", "appendix", "dataset_description"] },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page_count": { "type": "integer", "minimum": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": ["string", "null"] },
        "relationship_verified_by": { "type": "string" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "documentSet": {
      "type": "object",
      "required": ["primary_document_id", "documents"],
      "properties": {
        "primary_document_id": { "$ref": "#/$defs/id" },
        "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFile" } },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "bundleDescriptor": {
      "type": "object",
      "required": ["bundle_version", "delivery_mode", "profile"],
      "properties": {
        "bundle_version": { "const": "rpsme-bundle-1.0" },
        "delivery_mode": { "enum": ["json_only", "bundle"] },
        "manifest_path": { "type": ["string", "null"], "pattern": "^(manifest\\.json)?$" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "assetRights": {
      "type": "object",
      "required": ["access_level", "redistribution_allowed", "rights_basis"],
      "properties": {
        "access_level": { "enum": ["public", "restricted", "private_research", "unknown"] },
        "redistribution_allowed": { "type": ["boolean", "null"] },
        "rights_basis": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "assetDescriptor": {
      "type": "object",
      "required": ["asset_id", "sha256", "byte_size", "media_type", "origin_type", "availability_status", "rights", "profile"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "relative_path": { "type": ["string", "null"], "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "origin_type": { "enum": ["native_raw", "published_original", "pdf_extracted", "derived_thumbnail", "simulation_input", "simulation_output", "external_reference"] },
        "availability_status": { "enum": ["bundled", "external", "locator_only", "unavailable"] },
        "source_document_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "parent_asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "source_locator": { "type": "object" },
        "derivation": { "type": "object" },
        "rights": { "$ref": "#/$defs/assetRights" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "assetManifest": {
      "type": "object",
      "required": ["bundle_version", "assets", "profile"],
      "properties": {
        "bundle_version": { "const": "rpsme-bundle-1.0" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/assetDescriptor" } },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "sourceDocument": {
      "type": "object",
      "required": ["id", "source_type", "publication_number", "title", "jurisdiction", "application_date", "publication_date", "canonical_url", "language", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["patent", "paper", "master_thesis", "doctoral_thesis", "report", "standard", "internal_experiment"] },
        "publication_number": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "description": "Patent publication number or a stable source identifier for literature and other non-patent documents. Patent-specific syntax is enforced conditionally below."
        },
        "title": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 2 },
        "application_date": { "type": ["string", "null"], "format": "date" },
        "publication_date": { "type": ["string", "null"], "format": "date" },
        "canonical_url": { "type": ["string", "null"] },
        "language": { "type": "string", "minLength": 2 },
        "profile": { "$ref": "#/$defs/profile" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_type": { "const": "patent" } },
            "required": ["source_type"]
          },
          "then": {
            "properties": {
              "publication_number": { "pattern": "^[A-Z]{2}[A-Z0-9]{5,}$" }
            }
          }
        }
      ],
      "not": { "anyOf": [{ "required": ["upload"] }, { "required": ["uploaded_by"] }, { "required": ["uploaded_at"] }] }
    },
    "experimentRecord": {
      "type": "object",
      "required": ["id", "source_id", "label", "experiment_type", "material_family", "is_comparative", "record_status", "version", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "experiment_type": { "type": "string", "minLength": 1 },
        "material_family": { "type": "string", "minLength": 1 },
        "is_comparative": { "type": "boolean" },
        "baseline_experiment_id": { "type": ["string", "null"] },
        "record_status": { "enum": ["needs_source_action", "needs_extraction_review", "ready_for_primary_review"] },
        "version": { "type": "integer", "minimum": 1 },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "entityBase": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "experiment_id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "value_status": { "$ref": "#/$defs/valueStatus" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "documentElement": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["source_id", "element_type", "locator", "text"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "element_type": { "type": "string", "minLength": 1 },
        "locator": { "type": "object" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "material": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["entity_kind", "canonical_name", "identity_status", "profile"],
      "properties": {
        "entity_kind": { "enum": ["material_class", "chemical", "substance", "commercial_product", "purchased_batch"] },
        "canonical_name": { "type": "string", "minLength": 1 },
        "identity_status": { "type": "string", "minLength": 1 },
        "profile": { "type": "object", "properties": { "identity_resolution": { "$ref": "#/$defs/identityResolution" } } }
      }
    },
    "identityResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "experiment_ids", "evidence_ids", "composition", "identifiers"],
      "properties": {
        "role": { "enum": ["raw_material", "synthesized_material"] },
        "experiment_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "composition": { "type": "object" },
        "identifiers": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value", "evidence_ids"],
          "properties": {
            "type": { "enum": ["cas", "formula", "inchi_key", "canonical_smiles"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "reference": {
              "type": "object", "additionalProperties": false,
              "required": ["url", "accessed_at", "quote"],
              "properties": {
                "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                "accessed_at": { "type": "string", "format": "date-time" },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        } }
      },
      "allOf": [{
        "if": { "properties": { "role": { "const": "synthesized_material" } } },
        "then": { "properties": {
          "experiment_ids": { "minItems": 1 }, "evidence_ids": { "minItems": 1 },
          "composition": { "minProperties": 1 }, "identifiers": { "maxItems": 0 }
        } }
      }]
    },
    "materialAlias": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["material_id", "alias", "alias_type"],
      "properties": {
        "material_id": { "$ref": "#/$defs/id" },
        "alias": { "type": "string", "minLength": 1 },
        "alias_type": { "type": "string", "minLength": 1 }
      }
    },
    "recipe": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "recipe_type", "basis", "value_status", "profile"],
      "properties": {
        "recipe_type": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["original_value", "original_unit", "dimension"],
      "properties": {
        "original_value": {},
        "original_unit": { "type": ["string", "null"] },
        "normalized_value": {},
        "normalized_unit": { "type": ["string", "null"] },
        "dimension": { "type": "string", "minLength": 1 },
        "normalization_note": { "type": "string" }
      },
      "not": { "properties": { "original_value": { "type": "null" } }, "required": ["original_value"] }
    },
    "ingredientUsage": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "recipe_id", "material_id", "role", "basis_type", "basis", "value_status", "not_used", "evidence_ids", "profile"],
      "properties": {
        "recipe_id": { "$ref": "#/$defs/id" },
        "material_id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1 },
        "basis_type": { "enum": ["mass_parts", "mass_fraction", "volume_fraction", "actual_mass", "actual_volume", "amount_of_substance", "source_defined"] },
        "basis": { "type": "string", "minLength": 1 },
        "not_used": { "type": "boolean" },
        "amount": { "$ref": "#/$defs/measurement" }
      }
    },
    "processRoute": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "route_type", "value_status", "profile"],
      "properties": { "route_type": { "type": "string", "minLength": 1 } }
    },
    "processStep": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "route_id", "normalized_order", "source_step", "operation_type", "display_name_zh", "source_text", "value_status", "parameters", "evidence_ids", "profile"],
      "properties": {
        "route_id": { "$ref": "#/$defs/id" },
        "normalized_order": { "type": "integer", "minimum": 1 },
        "source_step": { "type": ["string", "integer"] },
        "source_substep": { "type": ["string", "null"] },
        "operation_type": { "type": "string", "minLength": 1 },
        "display_name_zh": { "type": "string", "minLength": 1 },
        "source_text": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "materialState": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "name", "value_status", "evidence_ids", "profile"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state_origin": { "enum": ["source_reported", "normalized_transition", "inferred", "unknown"] }
      }
    },
    "processFeed": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
      "required": ["experiment_id", "material_id", "feed_kind", "value_status", "evidence_ids", "profile"],
      "properties": {
        "material_id": { "$ref": "#/$defs/id" },
        "display_name_zh": { "type": "string" },
        "feed_kind": { "enum": ["auxiliary", "reinforcement", "substrate", "atmosphere", "other"] },
        "amount": { "$ref": "#/$defs/measurement" }
      }
    },
    "specimen": {
      "allOf": [{ "$ref": "#/$defs/entityBase" }],
      "type": "object",
