{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ready"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "selected"
        },
        "indices": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        }
      },
      "required": [
        "type",
        "indices"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "png"
        },
        "png": {
          "type": "string",
          "maxLength": 12582912,
          "pattern": "^data:image\\/png;base64,[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "type",
        "png"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rendered"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "bonds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        },
        "limited": {
          "type": "boolean"
        },
        "unsupported": {
          "maxItems": 118,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 3
          }
        },
        "colors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 3
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[a-f0-9]{6}$"
          }
        }
      },
      "required": [
        "type",
        "count",
        "bonds",
        "limited",
        "unsupported",
        "colors"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://materialsx.local/schemas/m6.2-v1/AtomicFrameEvent.json",
  "x-runtime-refinements": "Project ownership, realpath/symlink checks, SHA256 verification, force/atom counts, display limits and static-only config checks are mandatory."
}
