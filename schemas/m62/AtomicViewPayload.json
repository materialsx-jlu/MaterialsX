{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.2-v1"
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "import"
            },
            "projectId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "structureId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "projectId",
            "structureId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "projectId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "artifactId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "projectId",
            "runId",
            "artifactId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "structure": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "m6.0-v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "coordinateUnit": {
          "type": "string",
          "const": "angstrom"
        },
        "atoms": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "element": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "occupancy": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "element",
              "position",
              "occupancy"
            ],
            "additionalProperties": false
          }
        },
        "cell": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "pbc": {
          "type": "array",
          "prefixItems": [
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "charge": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "spinMultiplicity": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format": {
              "type": "string",
              "enum": [
                "cif",
                "xyz",
                "extxyz",
                "poscar"
              ]
            },
            "provenance": {
              "type": "string",
              "enum": [
                "user-file",
                "team-synthetic",
                "literature-reconstructed",
                "hypothesis"
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "transformations": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "required": [
            "artifactId",
            "sha256",
            "format",
            "provenance",
            "license",
            "transformations"
          ],
          "additionalProperties": false
        },
        "issues": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "warning",
                  "blocking"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "code",
              "severity",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "coordinateUnit",
        "atoms",
        "cell",
        "pbc",
        "charge",
        "spinMultiplicity",
        "source",
        "issues"
      ],
      "additionalProperties": false
    },
    "forcesEvPerAngstrom": {
      "anyOf": [
        {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "unreviewed",
        "needs_review"
      ]
    }
  },
  "required": [
    "version",
    "request",
    "structure",
    "forcesEvPerAngstrom",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.2-v1/AtomicViewPayload.json",
  "x-runtime-refinements": "Project ownership, realpath/symlink checks, SHA256 verification, force/atom counts, display limits and static-only config checks are mandatory."
}
