{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.5-v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "options": {
      "type": "object",
      "properties": {
        "ensemble": {
          "type": "string",
          "enum": [
            "nve",
            "nvt"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timestepFs": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "temperatureK": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "sampleEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "frictionInverseFs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ensemble",
        "steps",
        "timestepFs",
        "temperatureK",
        "sampleEvery",
        "seed",
        "frictionInverseFs"
      ],
      "additionalProperties": false
    },
    "atomCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "entries": {
      "minItems": 1,
      "maxItems": 2001,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "timeFs": {
            "type": "number",
            "minimum": 0
          },
          "frame": {
            "type": "object",
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2097152
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "offset",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "extxyz": {
            "type": "object",
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2097152
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "offset",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "index",
          "step",
          "timeFs",
          "frame",
          "extxyz"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "runId",
    "planId",
    "structureId",
    "options",
    "atomCount",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/MDIndex.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
