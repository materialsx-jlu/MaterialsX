{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "trajectory"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structure": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "m6.0-v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "coordinateUnit": {
          "type": "string",
          "const": "angstrom"
        },
        "atoms": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "element": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "occupancy": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "element",
              "position",
              "occupancy"
            ],
            "additionalProperties": false
          }
        },
        "cell": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "pbc": {
          "type": "array",
          "prefixItems": [
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "charge": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "spinMultiplicity": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format": {
              "type": "string",
              "enum": [
                "cif",
                "xyz",
                "extxyz",
                "poscar"
              ]
            },
            "provenance": {
              "type": "string",
              "enum": [
                "user-file",
                "team-synthetic",
                "literature-reconstructed",
                "hypothesis"
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "transformations": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "required": [
            "artifactId",
            "sha256",
            "format",
            "provenance",
            "license",
            "transformations"
          ],
          "additionalProperties": false
        },
        "issues": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "warning",
                  "blocking"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "code",
              "severity",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "coordinateUnit",
        "atoms",
        "cell",
        "pbc",
        "charge",
        "spinMultiplicity",
        "source",
        "issues"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "m6.5-v1"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "structureId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "step": {
          "type": "object",
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "timeFs": {
              "type": "number",
              "minimum": 0
            },
            "potentialEnergyEv": {
              "type": "number"
            },
            "kineticEnergyEv": {
              "type": "number",
              "minimum": 0
            },
            "totalEnergyEv": {
              "type": "number"
            },
            "temperatureK": {
              "type": "number",
              "minimum": 0
            },
            "maxForceEvPerAngstrom": {
              "type": "number",
              "minimum": 0
            },
            "minimumDistanceAngstrom": {
              "type": "number",
              "minimum": 0.4
            },
            "maxSpeedAngstromPerFs": {
              "type": "number",
              "minimum": 0
            },
            "elapsedSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "step",
            "timeFs",
            "potentialEnergyEv",
            "kineticEnergyEv",
            "totalEnergyEv",
            "temperatureK",
            "maxForceEvPerAngstrom",
            "minimumDistanceAngstrom",
            "maxSpeedAngstromPerFs",
            "elapsedSeconds"
          ],
          "additionalProperties": false
        },
        "positionsAngstrom": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "velocitiesAngstromPerFs": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "required": [
        "version",
        "runId",
        "planId",
        "structureId",
        "index",
        "step",
        "positionsAngstrom",
        "velocitiesAngstromPerFs"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "string",
      "enum": [
        "ball-stick",
        "sphere",
        "stick"
      ]
    },
    "showCell": {
      "type": "boolean"
    },
    "showBonds": {
      "type": "boolean"
    },
    "theme": {
      "type": "string",
      "enum": [
        "materials-dark",
        "codex-light"
      ]
    }
  },
  "required": [
    "type",
    "projectId",
    "structure",
    "frame",
    "style",
    "showCell",
    "showBonds",
    "theme"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/TrajectoryScene.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
