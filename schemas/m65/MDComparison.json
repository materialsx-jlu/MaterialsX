{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.5-v1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "runIds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        },
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "potentialIds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "enum": [
            "mace-mp-0b3-medium",
            "chgnet-0.3.0",
            "chgnet-r2scan"
          ]
        },
        {
          "type": "string",
          "enum": [
            "mace-mp-0b3-medium",
            "chgnet-0.3.0",
            "chgnet-r2scan"
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "series": {
      "type": "array",
      "prefixItems": [
        {
          "minItems": 2,
          "maxItems": 2001,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              },
              "timeFs": {
                "type": "number",
                "minimum": 0
              },
              "potentialEnergyEv": {
                "type": "number"
              },
              "kineticEnergyEv": {
                "type": "number",
                "minimum": 0
              },
              "totalEnergyEv": {
                "type": "number"
              },
              "temperatureK": {
                "type": "number",
                "minimum": 0
              },
              "maxForceEvPerAngstrom": {
                "type": "number",
                "minimum": 0
              },
              "minimumDistanceAngstrom": {
                "type": "number",
                "minimum": 0.4
              },
              "maxSpeedAngstromPerFs": {
                "type": "number",
                "minimum": 0
              },
              "elapsedSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "step",
              "timeFs",
              "potentialEnergyEv",
              "kineticEnergyEv",
              "totalEnergyEv",
              "temperatureK",
              "maxForceEvPerAngstrom",
              "minimumDistanceAngstrom",
              "maxSpeedAngstromPerFs",
              "elapsedSeconds"
            ],
            "additionalProperties": false
          }
        },
        {
          "minItems": 2,
          "maxItems": 2001,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              },
              "timeFs": {
                "type": "number",
                "minimum": 0
              },
              "potentialEnergyEv": {
                "type": "number"
              },
              "kineticEnergyEv": {
                "type": "number",
                "minimum": 0
              },
              "totalEnergyEv": {
                "type": "number"
              },
              "temperatureK": {
                "type": "number",
                "minimum": 0
              },
              "maxForceEvPerAngstrom": {
                "type": "number",
                "minimum": 0
              },
              "minimumDistanceAngstrom": {
                "type": "number",
                "minimum": 0.4
              },
              "maxSpeedAngstromPerFs": {
                "type": "number",
                "minimum": 0
              },
              "elapsedSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "step",
              "timeFs",
              "potentialEnergyEv",
              "kineticEnergyEv",
              "totalEnergyEv",
              "temperatureK",
              "maxForceEvPerAngstrom",
              "minimumDistanceAngstrom",
              "maxSpeedAngstromPerFs",
              "elapsedSeconds"
            ],
            "additionalProperties": false
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "energyDefinition": {
      "type": "string",
      "const": "within-model-total-energy-change-per-atom"
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    }
  },
  "required": [
    "version",
    "projectId",
    "runIds",
    "potentialIds",
    "series",
    "energyDefinition",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/MDComparison.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
