{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.5-v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000
    },
    "step": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "timeFs": {
          "type": "number",
          "minimum": 0
        },
        "potentialEnergyEv": {
          "type": "number"
        },
        "kineticEnergyEv": {
          "type": "number",
          "minimum": 0
        },
        "totalEnergyEv": {
          "type": "number"
        },
        "temperatureK": {
          "type": "number",
          "minimum": 0
        },
        "maxForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "minimumDistanceAngstrom": {
          "type": "number",
          "minimum": 0.4
        },
        "maxSpeedAngstromPerFs": {
          "type": "number",
          "minimum": 0
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "timeFs",
        "potentialEnergyEv",
        "kineticEnergyEv",
        "totalEnergyEv",
        "temperatureK",
        "maxForceEvPerAngstrom",
        "minimumDistanceAngstrom",
        "maxSpeedAngstromPerFs",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "positionsAngstrom": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    },
    "velocitiesAngstromPerFs": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    }
  },
  "required": [
    "version",
    "runId",
    "planId",
    "structureId",
    "index",
    "step",
    "positionsAngstrom",
    "velocitiesAngstromPerFs"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/MDFrame.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
