{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.5-v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "options": {
      "type": "object",
      "properties": {
        "ensemble": {
          "type": "string",
          "enum": [
            "nve",
            "nvt"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timestepFs": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "temperatureK": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "sampleEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "frictionInverseFs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ensemble",
        "steps",
        "timestepFs",
        "temperatureK",
        "sampleEvery",
        "seed",
        "frictionInverseFs"
      ],
      "additionalProperties": false
    },
    "completedSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "frameCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2001
    },
    "stopReason": {
      "type": "string",
      "const": "requested_steps_completed"
    },
    "initial": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "timeFs": {
          "type": "number",
          "minimum": 0
        },
        "potentialEnergyEv": {
          "type": "number"
        },
        "kineticEnergyEv": {
          "type": "number",
          "minimum": 0
        },
        "totalEnergyEv": {
          "type": "number"
        },
        "temperatureK": {
          "type": "number",
          "minimum": 0
        },
        "maxForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "minimumDistanceAngstrom": {
          "type": "number",
          "minimum": 0.4
        },
        "maxSpeedAngstromPerFs": {
          "type": "number",
          "minimum": 0
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "timeFs",
        "potentialEnergyEv",
        "kineticEnergyEv",
        "totalEnergyEv",
        "temperatureK",
        "maxForceEvPerAngstrom",
        "minimumDistanceAngstrom",
        "maxSpeedAngstromPerFs",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "final": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "timeFs": {
          "type": "number",
          "minimum": 0
        },
        "potentialEnergyEv": {
          "type": "number"
        },
        "kineticEnergyEv": {
          "type": "number",
          "minimum": 0
        },
        "totalEnergyEv": {
          "type": "number"
        },
        "temperatureK": {
          "type": "number",
          "minimum": 0
        },
        "maxForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "minimumDistanceAngstrom": {
          "type": "number",
          "minimum": 0.4
        },
        "maxSpeedAngstromPerFs": {
          "type": "number",
          "minimum": 0
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "timeFs",
        "potentialEnergyEv",
        "kineticEnergyEv",
        "totalEnergyEv",
        "temperatureK",
        "maxForceEvPerAngstrom",
        "minimumDistanceAngstrom",
        "maxSpeedAngstromPerFs",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "initialVelocitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialization": {
      "type": "string",
      "const": "Maxwell-Boltzmann-PCG64-exact-3N-temperature-COM-retained"
    },
    "degreesOfFreedom": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6000
    },
    "integrator": {
      "type": "string",
      "enum": [
        "VelocityVerlet",
        "Langevin"
      ]
    },
    "fixCenterOfMass": {
      "type": "boolean",
      "const": false
    },
    "nveDriftMevPerAtomPerPs": {
      "type": [
        "number",
        "null"
      ]
    },
    "nveVerdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "insufficient_duration",
        "not_applicable"
      ]
    },
    "nvtMeanTemperatureK": {
      "type": [
        "number",
        "null"
      ]
    },
    "nvtRelativeTemperatureError": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "nvtVerdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "insufficient_duration",
        "not_applicable"
      ]
    },
    "elapsedSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stepsPerSecond": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "peakMemoryMiB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "outputMiB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    }
  },
  "required": [
    "version",
    "runId",
    "planId",
    "structureId",
    "options",
    "completedSteps",
    "frameCount",
    "stopReason",
    "initial",
    "final",
    "initialVelocitySha256",
    "initialization",
    "degreesOfFreedom",
    "integrator",
    "fixCenterOfMass",
    "nveDriftMevPerAtomPerPs",
    "nveVerdict",
    "nvtMeanTemperatureK",
    "nvtRelativeTemperatureError",
    "nvtVerdict",
    "elapsedSeconds",
    "stepsPerSecond",
    "peakMemoryMiB",
    "outputMiB",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/MDSummary.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
