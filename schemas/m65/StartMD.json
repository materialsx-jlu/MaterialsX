{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "potentialId": {
      "type": "string",
      "enum": [
        "mace-mp-0b3-medium",
        "chgnet-0.3.0",
        "chgnet-r2scan"
      ]
    },
    "mdOptions": {
      "type": "object",
      "properties": {
        "ensemble": {
          "type": "string",
          "enum": [
            "nve",
            "nvt"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timestepFs": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "temperatureK": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "sampleEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "frictionInverseFs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ensemble",
        "steps",
        "timestepFs",
        "temperatureK",
        "sampleEvery",
        "seed",
        "frictionInverseFs"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxAtoms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxWallSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "maxMemoryMiB": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8192
        },
        "maxOutputMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "maxAtoms",
        "maxSteps",
        "maxWallSeconds",
        "maxMemoryMiB",
        "maxOutputMiB",
        "threads"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projectId",
    "structureId",
    "potentialId",
    "mdOptions"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/StartMD.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
