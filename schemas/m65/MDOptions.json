{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ensemble": {
      "type": "string",
      "enum": [
        "nve",
        "nvt"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "timestepFs": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "temperatureK": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "sampleEvery": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "frictionInverseFs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ensemble",
    "steps",
    "timestepFs",
    "temperatureK",
    "sampleEvery",
    "seed",
    "frictionInverseFs"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.5-v1/MDOptions.json",
  "x-runtime-refinements": "Owned immutable input, verified frame ranges/digests, actual step/time and numerical diagnostics must be checked by runtime."
}
