{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "potentialId": {
      "type": "string",
      "const": "sevennet-0-11jul2024"
    },
    "family": {
      "type": "string",
      "const": "sevennet"
    },
    "adapter": {
      "type": "string",
      "const": "sevennet-ase"
    },
    "basePotentialId": {
      "type": "string",
      "const": "sevennet-0-11jul2024"
    },
    "environmentProfileId": {
      "type": "string",
      "const": "sevennet-0.13.0-cpu-v1"
    },
    "dependencyLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "url": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2147483648
    },
    "license": {
      "type": "string",
      "maxLength": 128
    },
    "notices": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs\\/m6\\/licenses\\/[a-zA-Z0-9.-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "elements": {
      "minItems": 1,
      "maxItems": 118,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][a-z]?$"
      }
    },
    "loadedMemoryMiB": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 16384
    },
    "dtype": {
      "type": "string",
      "const": "float32"
    },
    "platforms": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "macos-arm64",
              "windows-x64"
            ]
          },
          "device": {
            "type": "string",
            "enum": [
              "cpu",
              "cuda",
              "mps"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "not-tested",
              "unsupported"
            ]
          },
          "evidenceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "platform",
          "device",
          "status",
          "evidenceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "potentialId",
    "family",
    "adapter",
    "basePotentialId",
    "environmentProfileId",
    "dependencyLockSha256",
    "sourceRevision",
    "url",
    "sha256",
    "bytes",
    "license",
    "notices",
    "reviewedAt",
    "elements",
    "loadedMemoryMiB",
    "dtype",
    "platforms"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m610/SevenNetPackage.json",
  "x-runtime-refinements": "Only the application-reviewed SevenNet ID, exact weight, pinned code, notices and environment lock are executable. Backend approval, actual capabilities, task/domain gates and real result hashes are checked locally. Public candidates are metadata only."
}
