{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.3-v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "finalStructureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "finalStructureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "options": {
      "type": "object",
      "properties": {
        "optimizer": {
          "type": "string",
          "const": "FIRE"
        },
        "cellMode": {
          "type": "string",
          "enum": [
            "fixed",
            "variable"
          ]
        },
        "cellConstraint": {
          "type": "string",
          "enum": [
            "none",
            "hydrostatic",
            "full"
          ]
        },
        "externalPressureGPa": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "fmaxEvPerAngstrom": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.2
        }
      },
      "required": [
        "optimizer",
        "cellMode",
        "cellConstraint",
        "externalPressureGPa",
        "maxSteps",
        "fmaxEvPerAngstrom"
      ],
      "additionalProperties": false
    },
    "stopReason": {
      "type": "string",
      "enum": [
        "converged",
        "max_steps"
      ]
    },
    "completedSteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "initial": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "energyEv": {
          "type": "number"
        },
        "objectiveEv": {
          "type": "number"
        },
        "maxForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "maxFilterForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "volumeAngstrom3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumDistanceAngstrom": {
          "type": "number",
          "minimum": 0.4
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "energyEv",
        "objectiveEv",
        "maxForceEvPerAngstrom",
        "maxFilterForceEvPerAngstrom",
        "volumeAngstrom3",
        "minimumDistanceAngstrom",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "final": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "energyEv": {
          "type": "number"
        },
        "objectiveEv": {
          "type": "number"
        },
        "maxForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "maxFilterForceEvPerAngstrom": {
          "type": "number",
          "minimum": 0
        },
        "volumeAngstrom3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumDistanceAngstrom": {
          "type": "number",
          "minimum": 0.4
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "energyEv",
        "objectiveEv",
        "maxForceEvPerAngstrom",
        "maxFilterForceEvPerAngstrom",
        "volumeAngstrom3",
        "minimumDistanceAngstrom",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "displacementDefinition": {
      "type": "string",
      "const": "final-minus-initial-cartesian-no-MIC-includes-cell-strain"
    },
    "displacementsAngstrom": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    }
  },
  "required": [
    "version",
    "runId",
    "planId",
    "structureId",
    "finalStructureId",
    "finalStructureSha256",
    "options",
    "stopReason",
    "completedSteps",
    "initial",
    "final",
    "displacementDefinition",
    "displacementsAngstrom",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.3-v1/RelaxationSummary.json",
  "x-runtime-refinements": "Project ownership, actual file hashes, atom mapping, convergence and history continuity require runtime validation."
}
