{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "inorganic-crystals",
        "molecules",
        "polymers",
        "surfaces",
        "interfaces",
        "unknown"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "production",
        "exploratory"
      ]
    },
    "permission": {
      "type": "string",
      "enum": [
        "inspect",
        "singlepoint",
        "relaxation",
        "md"
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "optimizer": {
          "type": "string",
          "const": "FIRE"
        },
        "cellMode": {
          "type": "string",
          "enum": [
            "fixed",
            "variable"
          ]
        },
        "cellConstraint": {
          "type": "string",
          "enum": [
            "none",
            "hydrostatic",
            "full"
          ]
        },
        "externalPressureGPa": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "fmaxEvPerAngstrom": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.2
        }
      },
      "required": [
        "optimizer",
        "cellMode",
        "cellConstraint",
        "externalPressureGPa",
        "maxSteps",
        "fmaxEvPerAngstrom"
      ],
      "additionalProperties": false
    },
    "mdOptions": {
      "type": "object",
      "properties": {
        "ensemble": {
          "type": "string",
          "enum": [
            "nve",
            "nvt"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timestepFs": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "temperatureK": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "sampleEvery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "frictionInverseFs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 0.1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ensemble",
        "steps",
        "timestepFs",
        "temperatureK",
        "sampleEvery",
        "seed",
        "frictionInverseFs"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "type": "string",
      "enum": [
        "short-range",
        "long-range-required"
      ]
    }
  },
  "required": [
    "projectId",
    "conversationId",
    "structureId",
    "domain",
    "mode",
    "permission"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m613/ScientificScope.json",
  "x-runtime-refinements": "Pinned ANI-2x eight-member weights and locked CPU runtime; explicit neutral singlet isolated boundary, charge/electron parity, no long-range term, no molecular stress; budgets, scientific quality and real files checked in worker and application."
}
