{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "potentialId": {
      "type": "string",
      "enum": [
        "mace-mp-0b3-medium",
        "chgnet-0.3.0",
        "chgnet-r2scan"
      ]
    }
  },
  "required": [
    "projectId",
    "datasetId",
    "potentialId"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.6-v1/ScientificEvaluationRequest.json",
  "x-runtime-refinements": "Actual identity, unit/atom mapping, reference provenance, matched theory/energy references, independent overlap review, per-domain quotas and project ownership must be verified; reports never grant production approval."
}
