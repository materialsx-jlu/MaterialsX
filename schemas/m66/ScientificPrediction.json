{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sampleId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "potentialId": {
      "type": "string",
      "enum": [
        "mace-mp-0b3-medium",
        "chgnet-0.3.0",
        "chgnet-r2scan"
      ]
    },
    "potentialSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "structureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "energyEv": {
      "type": "number"
    },
    "forcesEvPerAngstrom": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    }
  },
  "required": [
    "sampleId",
    "runId",
    "potentialId",
    "potentialSha256",
    "structureSha256",
    "energyEv",
    "forcesEvPerAngstrom"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.6-v1/ScientificPrediction.json",
  "x-runtime-refinements": "Actual identity, unit/atom mapping, reference provenance, matched theory/energy references, independent overlap review, per-domain quotas and project ownership must be verified; reports never grant production approval."
}
