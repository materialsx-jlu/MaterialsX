{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.6-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "potentialId": {
      "type": "string",
      "enum": [
        "mace-mp-0b3-medium",
        "chgnet-0.3.0",
        "chgnet-r2scan"
      ]
    },
    "potentialSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed-screening",
        "failed",
        "blocked"
      ]
    },
    "productionApproved": {
      "type": "boolean",
      "const": false
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    },
    "reasonCodes": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
      }
    },
    "totalSamples": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "completedSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "domains": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "bulk",
              "multi-element",
              "defect",
              "surface"
            ]
          },
          "samples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "energyMaeEvPerAtom": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "forceRmseEvPerAngstrom": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "domain",
          "samples",
          "required",
          "energyMaeEvPerAtom",
          "forceRmseEvPerAngstrom",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "predictions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "runId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "potentialId": {
            "type": "string",
            "enum": [
              "mace-mp-0b3-medium",
              "chgnet-0.3.0",
              "chgnet-r2scan"
            ]
          },
          "potentialSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "structureSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "energyEv": {
            "type": "number"
          },
          "forcesEvPerAngstrom": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "required": [
          "sampleId",
          "runId",
          "potentialId",
          "potentialSha256",
          "structureSha256",
          "energyEv",
          "forcesEvPerAngstrom"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "required": [
    "version",
    "id",
    "datasetId",
    "datasetSha256",
    "policySha256",
    "potentialId",
    "potentialSha256",
    "createdAt",
    "status",
    "productionApproved",
    "quality",
    "reasonCodes",
    "totalSamples",
    "completedSamples",
    "domains",
    "predictions",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.6-v1/ScientificEvaluationReport.json",
  "x-runtime-refinements": "Actual identity, unit/atom mapping, reference provenance, matched theory/energy references, independent overlap review, per-domain quotas and project ownership must be verified; reports never grant production approval."
}
