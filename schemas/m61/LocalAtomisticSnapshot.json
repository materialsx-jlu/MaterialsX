            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 268435456
          },
          "structureId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              {
