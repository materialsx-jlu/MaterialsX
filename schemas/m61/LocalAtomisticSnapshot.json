            "planId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "structureId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "potentialId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            },
            "potentialSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "atomCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "energyEv": {
              "type": "number"
            },
            "forcesEvPerAngstrom": {
              "minItems": 1,
              "maxItems": 2000,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "stress": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "const": "eV/angstrom^3"
                    },
                    "sign": {
                      "type": "string",
                      "const": "positive-tension"
                    },
                    "order": {
                      "type": "string",
                      "const": "xx,yy,zz,yz,xz,xy"
