              ]
            },
            "stopReason": {
              "type": "string",
              "enum": [
                "singlepoint",
                "converged",
                "max_steps",
                "cancelled",
                "failed"
              ]
            },
            "completedSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "quality": {
              "type": "string",
              "enum": [
                "unreviewed",
                "passed",
                "needs_review",
                "invalid"
              ]
            },
            "validationEvidenceIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              }
            }
          },
          "required": [
            "schemaVersion",
            "runId",
            "planId",
            "structureId",
            "potentialId",
            "potentialSha256",
            "atomCount",
            "energyEv",
            "forcesEvPerAngstrom",
            "stress",
            "stopReason",
            "completedSteps",
            "quality",
            "validationEvidenceIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "m6.0-v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "runId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic_structure",
              "atomic_trajectory",
              "atomistic_result",
              "validation_report",
              "plot",
              "image"
            ]
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
