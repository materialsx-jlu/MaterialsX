{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.12-v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "kind": {
      "type": "string",
      "const": "reviewed-checkpoints"
    },
    "entries": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "potentialId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dependencyLockSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "notices": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sha256",
                "bytes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "potentialId",
          "sha256",
          "bytes",
          "dependencyLockSha256",
          "sourceRevision",
          "notices"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "createdAt",
    "kind",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m612/OfflineCollection.json",
  "x-runtime-refinements": "Signed history, frozen checkpoint identities, notices, safe paths, in-use guards, disk capacity, preview hash and reproduction hashes are checked at runtime."
}
