{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "m6.0-v1"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "potentials": {
      "minItems": 10,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "m6.0-v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "family": {
            "type": "string",
            "enum": [
              "MACE",
              "CHGNet",
              "MatterSim",
              "ORB",
              "SevenNet",
              "MatGL",
              "UMA"
            ]
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "enum": [
              "core-candidate",
              "extension-candidate"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "url",
              "revision",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "url",
                "revision",
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "weights": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "download-hashed",
                  "publisher-digest",
                  "unverified"
                ]
              }
            },
            "required": [
              "url",
              "revision",
              "sha256",
              "bytes",
              "verification"
            ],
            "additionalProperties": false
          },
          "licenses": {
            "type": "object",
            "properties": {
              "code": {
                "type": "object",
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidenceIds": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "documented",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "expression",
                  "evidenceIds",
                  "status"
                ],
                "additionalProperties": false
              },
              "weights": {
                "type": "object",
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidenceIds": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "documented",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "expression",
                  "evidenceIds",
                  "status"
                ],
                "additionalProperties": false
              },
              "trainingData": {
                "type": "object",
                "properties": {
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "evidenceIds": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "documented",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "expression",
                  "evidenceIds",
                  "status"
                ],
                "additionalProperties": false
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "permitted-with-notices",
                  "review-required",
                  "restricted",
                  "unknown"
                ]
              }
            },
            "required": [
              "code",
              "weights",
              "trainingData",
              "redistribution"
            ],
            "additionalProperties": false
          },
          "declared": {
            "type": "object",
            "properties": {
              "energy": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "forces": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "stress": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "conservative": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "elements": {
                "anyOf": [
                  {
                    "minItems": 1,
                    "maxItems": 118,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "periodicity": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "bulk",
                    "slab",
                    "molecule"
                  ]
                }
              },
              "domains": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "headPolicy": {
                "type": "string",
                "enum": [
                  "single",
                  "required",
                  "unknown"
                ]
              },
              "heads": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "chargeInput": {
                "type": "string",
                "enum": [
                  "required",
                  "unsupported",
                  "unknown"
                ]
              },
              "spinInput": {
                "type": "string",
                "enum": [
                  "required",
                  "unsupported",
                  "unknown"
                ]
              },
              "nativeUnits": {
                "type": "object",
                "properties": {
                  "energy": {
                    "type": "string",
                    "enum": [
                      "eV",
                      "eV/atom",
                      "unknown"
                    ]
                  },
                  "forces": {
                    "type": "string",
                    "enum": [
                      "eV/angstrom",
                      "unknown"
                    ]
                  },
                  "stress": {
                    "type": "string",
                    "enum": [
                      "eV/angstrom^3",
                      "GPa",
                      "unknown"
                    ]
                  },
                  "stressConvention": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "energy",
                  "forces",
                  "stress",
                  "stressConvention"
                ],
                "additionalProperties": false
              },
              "temperatureRangeK": {
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pressureRangeGPa": {
                "anyOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceIds": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                }
              }
            },
            "required": [
              "energy",
              "forces",
              "stress",
              "conservative",
              "elements",
              "periodicity",
              "domains",
              "headPolicy",
              "heads",
              "chargeInput",
              "spinInput",
              "nativeUnits",
              "temperatureRangeK",
              "pressureRangeGPa",
              "evidenceIds"
            ],
            "additionalProperties": false
          },
          "energyReference": {
            "type": "object",
            "properties": {
              "functional": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "dataset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "convention": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "functional",
              "dataset",
              "convention"
            ],
            "additionalProperties": false
          },
          "environment": {
            "type": "object",
            "properties": {
              "adapter": {
                "type": "string",
                "enum": [
                  "mace-ase",
                  "chgnet-ase",
                  "mattersim-ase",
                  "orb-ase",
                  "sevennet-ase",
                  "matgl-ase",
                  "fairchem-ase"
                ]
              },
              "profileId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "codeRevision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "diskEstimateMiB": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "memoryEstimateMiB": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matrix": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "platform": {
                      "type": "string",
                      "enum": [
                        "macos-arm64",
                        "windows-x64"
                      ]
                    },
                    "device": {
                      "type": "string",
                      "enum": [
                        "cpu",
                        "cuda",
                        "mps"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "not-tested",
                        "unsupported",
                        "verified"
                      ]
                    },
                    "evidenceId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "platform",
                    "device",
                    "status",
                    "evidenceId"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "adapter",
              "profileId",
              "codeRevision",
              "diskEstimateMiB",
              "memoryEstimateMiB",
              "matrix"
            ],
            "additionalProperties": false
          },
          "state": {
            "type": "string",
            "enum": [
              "catalogued",
              "audited",
              "packaged",
              "installed",
              "runtime_verified",
              "task_validated",
              "failed",
              "unsupported",
              "disabled"
            ]
          },
          "installation": {
            "type": "string",
            "enum": [
              "absent",
              "bundled",
              "user-installed"
            ]
          },
          "runtimeEvidenceIds": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            }
          },
          "taskEvidenceIds": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "zh",
              "en"
            ],
            "additionalProperties": false
          },
          "examples": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "zh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "zh",
                "en"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "zh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "zh",
                "en"
              ],
              "additionalProperties": false
            }
          },
          "relatedCatalogIds": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "name",
          "family",
          "checkpoint",
          "role",
          "source",
          "evidence",
          "citation",
          "weights",
          "licenses",
          "declared",
          "energyReference",
          "environment",
          "state",
          "installation",
          "runtimeEvidenceIds",
          "taskEvidenceIds",
          "description",
          "examples",
          "limitations",
          "relatedCatalogIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "releaseId",
    "reviewedAt",
    "potentials"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m6.0-v1/PotentialRegistry.json",
  "x-contract-version": "m6.0-v1",
  "x-runtime-refinements": "packages/contracts/src/atomistic.ts refinements are mandatory; JSON Schema alone is insufficient. Authorization, realpath, file hash and resource checks belong to the local executor."
}
