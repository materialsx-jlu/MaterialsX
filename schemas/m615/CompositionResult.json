    "stressOrder": {
      "type": "string",
      "const": "xx,yy,zz,yz,xz,xy"
    },
    "stressSign": {
      "type": "string",
      "const": "positive-tension"
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    }
