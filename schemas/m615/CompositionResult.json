{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "m6.15-v1"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "energyEv": {
          "type": "number"
        },
        "forcesEvPerAngstrom": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "stress": {
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "energyEv",
        "forcesEvPerAngstrom",
        "stress"
      ],
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "properties": {
        "energyEv": {
          "type": "number"
        },
        "forcesEvPerAngstrom": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "stress": {
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "energyEv",
        "forcesEvPerAngstrom",
        "stress"
      ],
      "additionalProperties": false
    },
    "total": {
      "type": "object",
      "properties": {
        "energyEv": {
          "type": "number"
        },
        "forcesEvPerAngstrom": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "stress": {
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "energyEv",
        "forcesEvPerAngstrom",
        "stress"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "properties": {
        "energy": {
          "type": "string",
          "const": "eV"
        },
        "forces": {
          "type": "string",
          "const": "eV/angstrom"
        },
        "stress": {
          "type": "string",
          "const": "eV/angstrom^3"
        }
      },
      "required": [
        "energy",
        "forces",
        "stress"
      ],
      "additionalProperties": false
