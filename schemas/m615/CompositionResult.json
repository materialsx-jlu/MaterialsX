  "required": [
    "version",
    "profileSha256",
    "baseline",
    "correction",
    "total",
    "units",
    "stressOrder",
    "stressSign",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m615/CompositionResult.json",
  "x-runtime-refinements": "Fixed MACE+PBE-D3(BJ) two-body sum, no ATM/electrostatics; pinned shared baseline, sources, native engine and profile; CPU pure Si fixed-cell screening; component sums and real result files verified."
