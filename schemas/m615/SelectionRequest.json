{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "inorganic-crystals",
        "molecules",
        "polymers",
        "surfaces",
        "interfaces",
        "unknown"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "production",
        "exploratory"
      ]
    },
    "task": {
      "type": "string",
      "enum": [
        "singlepoint",
        "relaxation",
        "md"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxAtoms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxWallSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "maxMemoryMiB": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8192
        },
        "maxOutputMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "maxAtoms",
        "maxSteps",
        "maxWallSeconds",
        "maxMemoryMiB",
        "maxOutputMiB",
        "threads"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "type": "string",
      "enum": [
        "short-range",
        "long-range-required",
        "dispersion-required",
        "spin-required",
        "field-required",
        "delta-required",
        "multi-head-required"
      ]
    }
  },
  "required": [
    "projectId",
    "structureId",
    "domain",
    "mode",
    "task"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m615/SelectionRequest.json",
  "x-runtime-refinements": "Fixed MACE+PBE-D3(BJ) two-body sum, no ATM/electrostatics; pinned shared baseline, sources, native engine and profile; CPU pure Si fixed-cell screening; component sums and real result files verified."
}
