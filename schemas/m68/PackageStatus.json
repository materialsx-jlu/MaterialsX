{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "potentialId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,95}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "absent",
        "downloading",
        "paused",
        "installed",
        "disabled",
        "failed"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeReady": {
      "type": "boolean"
    },
    "quality": {
      "type": "string",
      "const": "needs_review"
    },
    "environmentProfileId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "cacheOwned": {
      "type": "boolean"
    }
  },
  "required": [
    "potentialId",
    "state",
    "bytes",
    "totalBytes",
    "sha256",
    "error",
    "runtimeReady",
    "quality",
    "environmentProfileId",
    "cacheOwned"
  ],
  "additionalProperties": false,
  "$id": "https://materialsx.local/schemas/m68/PackageStatus.json",
  "x-runtime-refinements": "Application-reviewed identity, dependencies, scoped authorization, actual Phase B compatibility, frozen plan hash and real result files are checked by the local runtime. Metadata never grants scientific accuracy."
}
