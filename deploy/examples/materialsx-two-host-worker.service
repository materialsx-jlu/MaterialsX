[Unit]
Description=MaterialsX preview billing worker
After=materialsx-api.service
Requires=materialsx-api.service

[Service]
Type=simple
User=mxapi
Group=mxapi
EnvironmentFile=/etc/materialsx/secrets/api-runtime.env
ExecStart=/opt/materialsx/control-plane/current/bin/worker
Restart=on-failure
RestartSec=5
MemoryMax=192M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/materialsx-api
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
