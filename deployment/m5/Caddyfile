# MATERIALSX_PUBLIC_HOST must be your approved HTTPS host, without a scheme.
{$MATERIALSX_PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 256KB
    }
    reverse_proxy 127.0.0.1:8788 {
        flush_interval -1
        header_up Host {$MATERIALSX_PUBLIC_HOST}
    }
    # No access logging of auth query tokens / user URLs.
}
