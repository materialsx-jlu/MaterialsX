[Unit]
Description=MaterialsX account API
After=network-online.target
Wants=network-online.target

[Service]
User=materialsx
Group=materialsx
WorkingDirectory=/opt/materialsx
EnvironmentFile=/etc/materialsx/api.env
ExecStart=/opt/materialsx/bin/identity
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/materialsx /opt/materialsx
ReadWritePaths=/var/lib/materialsx
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
